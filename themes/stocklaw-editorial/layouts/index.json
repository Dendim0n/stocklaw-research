{{- $pages := .Site.RegularPages -}}
[
{{- range $i, $page := $pages -}}
{{- if $i }},{{ end }}
{
  "title": {{ $page.Title | jsonify }},
  "date": {{ $page.Date.Format "2006-01-02" | jsonify }},
  "permalink": {{ $page.Permalink | jsonify }},
  "section": {{ $page.Section | jsonify }},
  "description": {{ ($page.Description | default "") | jsonify }},
  "tags": {{ ($page.Params.tags | default (slice)) | jsonify }},
  "content": {{ (delimit (split $page.Plain "\n") " " | truncate 500) | jsonify }}
}
{{- end }}
]
